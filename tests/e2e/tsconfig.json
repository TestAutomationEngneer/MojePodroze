{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@_src/*": ["./src/*"],
      "@_config/*": ["./config/*"],
      "@_pw-config": ["./playwright.config.ts"]
    }
  },
  "include": ["**/*.ts"]
}
